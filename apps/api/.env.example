# Copy to apps/api/.env (gitignored) and fill in.
# Get the v4 Read Access Token from:
#   https://www.themoviedb.org/settings/api → "API Read Access Token"
TMDB_READ_ACCESS_TOKEN=

# Optional
PORT=3001
NODE_ENV=development

# Torrent streaming mode (optional; local-only). Absence disables torrent mode.
# JACKETT_API_KEY gates the feature — copy it from the Jackett dashboard.
JACKETT_URL=http://127.0.0.1:9117
JACKETT_API_KEY=
TORRSERVER_URL=http://127.0.0.1:8090
# Set to the machine's LAN IP (e.g. http://192.168.1.5:8090) to watch from other devices.
TORRSERVER_PUBLIC_URL=

# Subtitles via OpenSubtitles (optional). Free API key from the developer
# portal at https://www.opensubtitles.com/en/consumers . Absent key = no CC.
OPENSUBTITLES_API_KEY=
# Optional login raises the daily download quota.
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
OPENSUBTITLES_APP_NAME=mobius v0.1
